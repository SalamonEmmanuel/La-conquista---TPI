Object subclass: #Casilla	instanceVariableNames: 'propietario numeroMinijuego'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!Casilla methodsFor: 'accessing' stamp: 'manucho 11/23/2024 19:24'!propietario: unJugador    propietario := unJugador.! !!Casilla methodsFor: 'accessing' stamp: 'manucho 11/23/2024 19:24'!propietario    ^ propietario.! !!Casilla methodsFor: 'accessing' stamp: 'manucho 11/23/2024 20:23'!cambiarPropietario: unJugador    "Cambia el propietario de la casilla al jugador especificado."    propietario := unJugador.! !!Casilla methodsFor: 'accessing' stamp: 'manucho 11/23/2024 19:25'!numeroMinijuego: unNumero    numeroMinijuego := unNumero.! !!Casilla methodsFor: 'accessing' stamp: 'manucho 11/23/2024 19:25'!numeroMinijuego    ^ numeroMinijuego.! !!Casilla methodsFor: 'initialization' stamp: 'manucho 11/23/2024 19:32'!initialize    propietario := nil.    numeroMinijuego := 0.! !SimpleSwitchMorph subclass: #CasillaInterfaz	instanceVariableNames: 'casilla'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!CasillaInterfaz methodsFor: 'accessing' stamp: 'manucho 11/23/2024 21:05'!casilla: unaCasilla    casilla := unaCasilla.! !!CasillaInterfaz methodsFor: 'accessing' stamp: 'manucho 11/23/2024 21:05'!actualizarConPropietario    "Actualiza la interfaz gráfica de la casilla para mostrar el propietario."    | textoPropietarioMorph |    textoPropietarioMorph := StringMorph contents: (casilla propietario idNombre ifNil: ['']).     textoPropietarioMorph position: self position + (10@10). "Ajustar posición dentro de la casilla"    self addMorph: textoPropietarioMorph.! !!CasillaInterfaz methodsFor: 'drawing' stamp: 'manucho 11/23/2024 05:52'!drawOn: aCanvas    aCanvas fillRectangle: self bounds color: color.! !!CasillaInterfaz methodsFor: 'initialization' stamp: 'manucho 11/23/2024 06:42'!initialize    super initialize.    color := Color random.    self extent: 50@50.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CasillaInterfaz class	instanceVariableNames: ''!!CasillaInterfaz class methodsFor: 'instance creation' stamp: 'manucho 11/23/2024 03:45'!new        ^super new initialize! !BorderedMorph subclass: #InterfazMenuConquista	instanceVariableNames: 'cabecera botonInicio botonCerrar botonReglas'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!InterfazMenuConquista methodsFor: 'accessing' stamp: 'manucho 11/23/2024 05:45'!inicioTablero    | dimensiones |    dimensiones := self solicitarDimensiones.    TableroInterfaz new size: dimensiones; openInWorld.! !!InterfazMenuConquista methodsFor: 'accessing' stamp: 'manucho 11/23/2024 05:47'!terminar    self delete.		! !!InterfazMenuConquista methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 04:07'!solicitarDimensiones     "Solicitar al usuario las dimensiones del tablero"    | opciones seleccion |    opciones := #('2x2' '3x3' '4x4').    seleccion := UIManager default chooseFrom: opciones title: 'Seleccione el tamaño del tablero'.    ^seleccion = 0 ifTrue: [2] ifFalse: [        (seleccion = 1) ifTrue: [2] ifFalse: [            (seleccion = 2) ifTrue: [3] ifFalse: [4]        ]    ].! !!InterfazMenuConquista methodsFor: 'initialization' stamp: 'manucho 11/23/2024 06:11'!crearBotones"Crea y posiciona los botones del menú."    botonInicio := self crearBoton: 'Iniciar Tablero' ejecutar: #inicioTablero.    botonReglas := self crearBoton: 'Explicar Reglas' ejecutar: #reglas.    botonCerrar := self crearBoton: 'Cerrar Juego' ejecutar: #terminar.    botonInicio position: self position + (100@100).    botonReglas position: self position + (100@150).    botonCerrar position: self position + (100@200).    self addMorph: botonInicio.    self addMorph: botonReglas.    self addMorph: botonCerrar.! !!InterfazMenuConquista methodsFor: 'initialization' stamp: 'manucho 11/22/2024 20:11'!crearCabecera "Crea y posiciona la cabecera del menú."        cabecera := StringMorph contents: '¡Bienvenido al juego La Conquista!!'.        cabecera position: (self position + (52@50)).        self addMorph: cabecera! !!InterfazMenuConquista methodsFor: 'initialization' stamp: 'manucho 11/23/2024 06:10'!crearBoton: etiqueta ejecutar: accion    | boton |    boton := PluggableButtonMorph new.    boton label: etiqueta.    boton model: self. "El receptor del mensaje será el objeto actual (self)"    boton actionSelector: accion. "Acción a ejecutar al presionar el botón"    ^boton."Método auxiliar para crear un botón con un título y una acción específica."! !!InterfazMenuConquista methodsFor: 'initialization' stamp: 'manucho 11/23/2024 01:09'!initialize	"Este metodo inicializa toda la parte grafica del menú, genera los botones y los adhiere a la estructura"        super initialize.        self configurarVentana.        self crearCabecera.        self crearBotones.        self openInWorld.! !!InterfazMenuConquista methodsFor: 'initialization' stamp: 'manucho 11/23/2024 05:44'!configurarVentana"Configura las propiedades de la ventana, como el tamaño y el color."  self bounds: (850@250 extent: 300@300).  self color: Color white.! !Object subclass: #Jugador	instanceVariableNames: 'idNombre territorio'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!Jugador methodsFor: 'initialization' stamp: 'manucho 11/23/2024 20:19'!initializeWithId: id    idNombre := id.    territorio := OrderedCollection new.! !!Jugador methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 20:21'!agregarCasilla: unaCasilla    "Agrega una casilla al territorio del jugador y actualiza el propietario de la casilla."    territorio add: unaCasilla.    unaCasilla cambiarPropietario: self.! !!Jugador methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 20:22'!vaciarTerritorio    "Elimina todas las casillas del territorio del jugador."    territorio do: [:casilla |        casilla cambiarPropietario: nil.    ].    territorio := OrderedCollection new.! !!Jugador methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 20:23'!usurparTerritorio: otroJugador    "Transfiere todas las casillas del otro jugador al territorio de este jugador."    otroJugador territorio do: [:casilla |        self agregarCasilla: casilla.    ].    otroJugador vaciarTerritorio.! !!Jugador methodsFor: 'accessing' stamp: 'manucho 11/23/2024 20:22'!idNombre    ^idNombre.! !!Jugador methodsFor: 'accessing' stamp: 'manucho 11/23/2024 20:22'!territorio    ^territorio.! !!Jugador methodsFor: 'accessing' stamp: 'manucho 11/23/2024 21:24'!idNombre: unNombre    idNombre := unNombre.! !Object subclass: #Tablero	instanceVariableNames: 'matriz'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!Tablero methodsFor: 'initialization' stamp: 'manucho 11/23/2024 19:30'!initialize: size    | filas columnas |    filas := size. "Por ejemplo, 2 para un tablero 2x2"    columnas := size.    matriz := Array2D rows: filas columns: columnas.    1 to: filas do: [:fila |        1 to: columnas do: [:columna |            matriz at: fila at: columna put: (Casilla new numeroMinijuego: (fila * columna); yourself).        ].    ].! !!Tablero methodsFor: 'accessing' stamp: 'manucho 11/23/2024 19:31'!cambiarPropietarioDeCasillaEnFila: fila columna: columna a: nuevoPropietario    "Cambia el propietario de la casilla especificada"    | casilla |    casilla := self casillaEnFila: fila columna: columna.    casilla cambiarPropietario: nuevoPropietario.! !!Tablero methodsFor: 'accessing' stamp: 'manucho 11/23/2024 06:28'!size: size"Inicializa el tablero con las dimensiones dadas"    matriz := Array2D new: size.! !!Tablero methodsFor: 'accessing' stamp: 'manucho 11/23/2024 19:31'!casillaEnFila: fila columna: columna    "Devuelve la casilla en la posición especificada"    ^ matriz at: fila at: columna.! !!Tablero methodsFor: 'accessing' stamp: 'manucho 11/22/2024 18:55'!matriz	^ matriz! !!Tablero methodsFor: 'accessing' stamp: 'manucho 11/22/2024 18:55'!matriz: anObject	matriz := anObject! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Tablero class	instanceVariableNames: ''!!Tablero class methodsFor: 'instance creation' stamp: 'manucho 11/23/2024 02:53'!new: size        ^super new initialize: size! !BorderedMorph subclass: #TableroInterfaz	instanceVariableNames: 'tablero'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!TableroInterfaz methodsFor: 'initialization' stamp: 'manucho 11/23/2024 03:38'!initialize: size         super initialize.        tablero := Tablero new: size.        self crearInterfaz.! !!TableroInterfaz methodsFor: 'accessing' stamp: 'manucho 11/23/2024 05:50'!size: size"Inicia el tablero con las dimensiones especificadas"    tablero := Tablero new size: size.    self initialize.    self crearInterfaz.! !!TableroInterfaz methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 19:33'!crearInterfaz    | filas columnas |    filas := tablero matriz numberOfRows.    columnas := tablero matriz numberOfColumns.    1 to: filas do: [:fila |        1 to: columnas do: [:columna |            | casilla casillaMorph |            casilla := tablero casillaEnFila: fila columna: columna.            casillaMorph := self crearCasillaMorph: casilla fila: fila columna: columna.            self addMorph: casillaMorph.        ].    ].! !!TableroInterfaz methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 03:52'!crearCasillaMorph: casilla        | casillaMorph |        casillaMorph := CasillaInterfaz new.        ^casillaMorph! !!TableroInterfaz methodsFor: 'as yet unclassified' stamp: 'manucho 11/23/2024 21:42'!crearCasillaMorph: casilla fila: fila columna: columna"Crea un Morph para cada casilla"    | casillaMorph posicion |    casillaMorph := CasillaInterfaz new.    posicion := ((columna - 1) * 50) @ ((fila - 1) * 50).    casillaMorph position: posicion.    ^ casillaMorph.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!TableroInterfaz class	instanceVariableNames: ''!!TableroInterfaz class methodsFor: 'instance creation' stamp: 'manucho 11/23/2024 02:28'!new: size^super new initialize: size! !