SimpleSwitchMorph subclass: #Casilla	instanceVariableNames: 'mouseAction n t etiqueta jugador'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!Casilla methodsFor: 'acccessing' stamp: 'MaraLandaeta 11/19/2024 20:34'!modificarNumCasilla: nuevoTexto    etiqueta contents: nuevoTexto.! !!Casilla methodsFor: 'event handling' stamp: 'MaraLandaeta 11/19/2024 10:12'!mouseMove: anEvent"Metodo para seguir el movimiento del mouse, asi lo explica la documentacion"! !!Casilla methodsFor: 'event handling' stamp: 'MaraLandaeta 11/19/2024 10:12'!mouseUp: anEvent"Esto va a observar cuando el mouse se levante, representando el click, y va a ejecutar el valor de mouseAction "	mouseAction value! !!Casilla methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 10:12'!mouseAction: anEvent"Metodo getter/setter que ejecuta el bloque de codigo asignado a mouseAction, visto en crearBloque o crearBizarro"	^mouseAction := anEvent! !!Casilla methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 10:52'!n"Getter de n para obtener el puntaje"	^ n! !!Casilla methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 10:53'!n: anObject"Setter que no se uso pero lo dejamos porque no afecta"	n := anObject! !!Casilla methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 20:33'!etiqueta: unaEtiqueta    etiqueta := unaEtiqueta.! !!Casilla methodsFor: 'accessing' stamp: 'MaraLandaeta 11/22/2024 12:15'!jugador: unJugador    jugador := unJugador.! !!Casilla methodsFor: 'accessing' stamp: 'MaraLandaeta 11/22/2024 12:16'!jugador    ^ jugador.! !!Casilla methodsFor: 'initialization' stamp: 'MaraLandaeta 11/19/2024 20:37'!asignarTema"Asigna tema por cada casilla dentro de crearCasilla:at:"|temas temaAleatorio|temas := {'Historia'. 'Ciencia'. 'Arte'. 'Deportes'. 'Literatura'. 'Matemáticas'.          'Física'. 'Química'. 'Biología'. 'Tecnología'. 'Filosofía'. 'Economía'.          'Música'. 'Cine'. 'Geografía'. 'Política'. 'Psicología'. 'Religión'.          'Arquitectura'. 'Astronomía'. 'Ecología'. 'Medicina'. 'Lingüística'.          'Cultura'. 'Sociología'}.temaAleatorio:=temas atRandom.^temaAleatorio! !!Casilla methodsFor: 'initialization' stamp: 'MaraLandaeta 11/22/2024 11:21'!initialize "Metodo para crear el morph bloque, el valor n es el entero que se va a sumar al puntaje cuando el jugador interactue con el bloque"			super initialize.	self label: ''.	self borderWidth: 5.	bounds:= 0@0 corner: 75@75.	onColor := (Color lightGray).	offColor := Color darkGray.	self turnOn.! !BorderedMorph subclass: #Duelo	instanceVariableNames: 'jugador'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!BorderedMorph subclass: #InicioConquista	instanceVariableNames: 'botonAyuda'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!InicioConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/19/2024 09:41'!reiniciar	"Este metodo se utiliza cuando salimos de la Ayuda para volver al menu principal"	InicioConquista  new openInWorld.	! !!InicioConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/18/2024 19:13'!boton: etiqueta ejecutar: accion	"Metodo auxiliar para crear botones en la interfaz, necesarios para los botones de ayuda, iniciar partida y cerrar, tambien usado en la clase partida"		|boton|	boton := SimpleButtonMorph new label: etiqueta. "El Morph de boton, la clase, cuenta con la caracteristica de manejar estados, encendido y apagado por defecto cuando se genera un evento de click de boton"	boton color: (Color r:0  g:51  b:102  alpha:0.5) .	boton borderWidth:  1.	boton borderColor: Color black.	boton extent: 90@50.	boton fitContents.	boton on: #click send: #value to: accion.	^boton. ! !!InicioConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/19/2024 22:38'!initialize	"Este metodo inicializa toda la parte grafica del menu, genera los botones y los adhiere a la estructura"	|cabecera botonInicio botonCerrar botonReglas botonMostrarTemas|		super initialize.	self bounds: (850@250 extent: 300@300).	self color: (Color r: 1 g:1 b:1 alpha:1).		cabecera := StringMorph contents: '¡Bienvenido al juego La Conquista!!'.	cabecera position: (self position + (52@50)).	self addMorph: cabecera.		botonInicio:= self boton: 'Iniciar Tablero' ejecutar:[self inicioTablero].	botonReglas:= self boton: 'Explicar Reglas' ejecutar:[self reglas].	botonCerrar := self boton: 'Cerrar Juego' ejecutar:[self terminar].	botonInicio position: (self position + (100@100)).	botonReglas position: (self position + (100@150)).	botonCerrar position: (self position + (103@200)).	self addMorph: botonInicio.	self addMorph: botonReglas.	self addMorph: botonCerrar.		self openInWorld.	! !!InicioConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/18/2024 19:19'!reglas	"Este metodo usa estructuras de morph para crear un cuadro de texto que explique al usuario las caracteristicas del juego"	|texto cuadro botonCerrar|	self delete.	cuadro:= BorderedMorph new.	cuadro bounds: (1500@550 corner:700@300).	cuadro color: (Color r:0.38 g:0.33 b:0.39 alpha:1).	texto:= TextMorph new.	texto contents: 'Estas son las reglas del juego'.	texto center: cuadro center.	cuadro addMorph: texto.		botonCerrar:= self boton: 'Entendido' ejecutar: [cuadro delete.		self reiniciar].	botonCerrar position: (cuadro position+(300@252)).	cuadro addMorph: botonCerrar.	cuadro openInWorld.			! !!InicioConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/18/2024 19:12'!terminar	"Este metodo elimina a la instancia de menu"	|mensaje|	mensaje:= (UIManager default 						   chooseFrom: #('Si' 'No') 	values: #(1 2)   lines:  #(1 2) message: '¬øDesea cerrar el juego?'  title: 'Cerrar').	(mensaje=1) ifTrue:  [ self delete ]			  		ifFalse: [ UIManager default alert:'Hasta luego!!'].		! !!InicioConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/18/2024 19:52'!inicioTablero	"Este m√©todo simplemente desencadena una instancia de partida a la vez que destruye la instancia de menu"	|part|	self delete.	part:= TableroConquista new openInWorld.! !Object subclass: #Player	instanceVariableNames: 'numJugador casillas puntaje estado coordenadaLock retador retado turno cantidadDeCasillas'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!Player methodsFor: 'initialization' stamp: 'MaraLandaeta 11/22/2024 16:23'!crear:aString casillaInicial: aCoord"INICIA JUGADOR EN UNA COORDENADA, ES LO Q TENGO ENTENDIDO PERO NO ME QUEDA CLARO" numJugador := aString. coordenadaLock:=aCoord.cantidadDeCasillas:= 1.! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 23:23'!numJugador: unNumero numJugador:=unNumero! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/21/2024 23:15'!retador: unRetador"Setter de retador para definir que jugador es el que reta, y por lo tanto, escoge las casillas adyacentes"	retador := unRetador! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 22:49'!numJugador"Getter del nombre para imprimir los mensajes"	^numJugador.! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/21/2024 23:17'!casillas: unaCasilla"COMO CADA JUGADOR TIENE VARIAS CASILLAS PENSÉ EN Q PODRÍA SER UN ORDERED COLLECTION, PERO LET'S SEE"casillas:=unaCasilla! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/21/2024 23:15'!retado: unRetado"Setter de retador para definir que jugador es el que es retado, y por lo tanto, también participa en el duelo"	retado := unRetado! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/22/2024 11:43'!turno: anObject"Setter de estado para definir TURNOS de la partida, TIPO JUGANDO O ESPERA"	turno := anObject! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/20/2024 23:28'!coordenadaLock"Getter para leer la coordenada asignada"	^ coordenadaLock! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/21/2024 23:07'!retado"Getter de si es un retador para comprobaciones booleanas"	^ retado! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/21/2024 23:07'!retador"Getter de si es un retador para comprobaciones booleanas"	^ retador! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/22/2024 11:42'!turno"Getter de estado para comprobaciones booleanas"	^ turno! !!Player methodsFor: 'accessing' stamp: 'MaraLandaeta 11/21/2024 23:20'!coordenadaLock: anObject"Setter para definir la coordenada correspondiente. CREO QUE ES LA COORDENADA BLOQUEADA"	coordenadaLock := anObject! !BorderedMorph subclass: #TableroConquista	instanceVariableNames: 'tablerou tamano contador unJugador jugador p1 retador retado numeroAsignado'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquista'!!TableroConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/19/2024 22:39'!funcionalidades	"M√©todo de construcci√≥n puramente gr√°fico, para la secci√≥n de botones con funciones del tablero"	|barra botonReinicio botonCerrar botonMostrarTemas|	barra := Morph new layoutPolicy: RowLayout new; color: Color transparent.		botonReinicio  := self boton: 'Reiniciar' ejecutar: [ self reinicio ].	botonCerrar := self boton: 'Cerrar' ejecutar: [ self terminar ].	botonMostrarTemas :=self boton: 'Mostrar Temas' ejecutar: [self terminar].		barra addMorphCentered: botonCerrar.	barra addMorph: botonReinicio.		(tablerou at:1 at:1) addMorph: barra.	barra position: 1000@200.	^barra! !!TableroConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/18/2024 19:52'!boton: etiqueta ejecutar: accion"Igual al de inicio, m√©todo auxiliar de creacion de interfaz"	|boton|	boton := SimpleButtonMorph new label: etiqueta.	boton color: (Color r:0  g:51  b:102  alpha:0.5)  .	boton borderWidth:  1.	boton borderColor: Color black.	boton extent: 90@50.	boton fitContents.	boton on: #click send: #value to: accion.	^boton.  ! !!TableroConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/22/2024 15:45'!initialize"Este m√©todo inicializa la estructura grafica del tablero, adem√°s de declarar los valores de inicio de juego tales como nombre de jugador, zona de inicio,Tambien genera tableros distintos "| casilla t alto ancho   numerosAleatorios|super initialize.casilla:= Casilla new.alto := casilla height.ancho := casilla width.self elegirTamano. "Este método define el tamaño del tablero (tamano)"t := tamano.self bounds:		(755 @ 240 extent: ancho * t @ (alto * t) + (2 * self borderWidth)).	self color: (Color blue alpha: 0.5).contador:=0.numerosAleatorios := (1 to: tamano*tamano) asArray shuffled."Crear el tablero usando rows:columns:tabulate:"tablerou  := Array2D new: t    tabulate: [:fila :columna | numeroAsignado := numerosAleatorios at: (contador := contador + 1). self crearCasilla:fila at:columna numero: numeroAsignado .	]. "Inicializa cada celda con nil""Guardar el tablero en una variable de instancia"self tablero: tablerou.self funcionalidades.		UIManager default alert: 'Inicio de Partida: Ronda 1. Turno de Jugador '.! !!TableroConquista methodsFor: 'initialization' stamp: 'MaraLandaeta 11/22/2024 15:49'!elegirTamano	"Setter de dificultad que usa UIManager para mostrar una lista de opciones"	tamano:=(UIManager default 	chooseFrom: #('2x2)' '(3x3)' '(4x4)') 	values: #(2 3 4) 	lines: #(1 2 3) 	message: 'Elija el tamaño del tablero' title: 'LaConquista').! !!TableroConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/22/2024 16:24'!crearCasilla: i at: j numero: unNumero	"Metodo de creacion de instancia de clase Casilla"	|temp newplayer origen colorBloque etiqueta|	origen:= self innerBounds origin.	temp:=Casilla new.	temp jugador: numeroAsignado.	temp position: ((i-1)*temp width)@((j-1)*temp height) + origen.	temp mouseAction: [ self procesarAdyacenteAt: i at: j ]. " aca tipo no se que fue lo que hice pero se puede borrar esta linea, esto era para encontrar el adyacente tho no lo definí"	 colorBloque := (i + j) even        ifTrue: [Color pink]        ifFalse: [Color white].    temp color: colorBloque.    "Crear etiqueta"    etiqueta := TextMorph new.    etiqueta contents: unNumero asString.    etiqueta position: temp position + (temp width / 2 - (etiqueta width / 2) @ (temp height / 2 - (etiqueta height / 2))).    temp addMorph: etiqueta.    temp etiqueta: etiqueta.    self addMorph: temp.	newplayer:=Player new.	newplayer crear: numeroAsignado asString casillaInicial: numeroAsignado.    ^ temp! !!TableroConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 10:25'!terminar	"Elimina el tablero"	|mensaje|	mensaje:= (UIManager default 						   chooseFrom: #('Si' 'No') 	values: #(1 2)   lines:  #(1 2) message: '¬øDesea cerrar el juego?'  title: 'Cerrar').	(mensaje=1) ifTrue:  [ self delete ]			  		ifFalse: [ UIManager default alert:'Bien, tenga cuidado la proxima'].! !!TableroConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/18/2024 23:33'!tamano	"Getter de tamaño"	^ tamano! !!TableroConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 10:43'!tablero: unTablero    tablerou := unTablero.! !!TableroConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/22/2024 12:31'!casillasDeJugador: jugadorr    "Devuelve una lista de las casillas ocupadas por el jugador"    | casillasJugador |    casillasJugador := (tablerou collect: [:fila |        fila select: [:casilla | casilla jugador = jugadorr]    ]) flatten.    ^ casillasJugador.! !!TableroConquista methodsFor: 'accessing' stamp: 'MaraLandaeta 11/19/2024 10:24'!reinicio	"Igual que en inicio, elimina la instancia actual y crea una nueva"	|mensaje|	mensaje:= (UIManager default 						   chooseFrom: #('Si' 'No') 	values: #(1 2)   lines:  #(1 2) message: '¬øDesea reiniciar el juego?'  title: 'Nuevo Juego').	(mensaje=1) ifTrue:  [ self delete.		Partida new openInWorld. ]			  		ifFalse: [ UIManager default popUpInWorld:'Bien, cuando quieran'].! !