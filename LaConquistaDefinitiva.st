Object subclass: #Casillero	instanceVariableNames: 'minijuego'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquistaDefinitiva'!!Casillero methodsFor: 'accessing' stamp: 'Alan 11/21/2024 02:39'!minijuego: unMinijuego    minijuego := unMinijuego.! !!Casillero methodsFor: 'accessing' stamp: 'Alan 11/21/2024 11:03'!minijuego	^minijuego.! !!Casillero methodsFor: 'initialization' stamp: 'Alan 11/21/2024 11:02'!initialize    minijuego := nil.! !!Casillero methodsFor: 'converting' stamp: 'Alan 11/21/2024 11:05'!asString 	^minijuego isNil		ifTrue:['Casillero vacio']		ifFalse:[minijuego asString].! !Object subclass: #Duelo	instanceVariableNames: 'retador retado tema tiempoRestante'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquistaDefinitiva'!!Duelo methodsFor: 'initialization' stamp: 'Alan 11/20/2024 19:53'!initialize    tiempoRestante := 30. "Tiempo base para cada jugador en un duelo"! !Object subclass: #Jugador	instanceVariableNames: 'nombre casillas tiempoDisponible'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquistaDefinitiva'!!Jugador methodsFor: 'as yet unclassified' stamp: 'Alan 11/21/2024 01:55'!agregarCasilla: unaCasilla    "Agrega una casilla a la colección de casillas del jugador."    casillas add: unaCasilla! !!Jugador methodsFor: 'as yet unclassified' stamp: 'Alan 11/21/2024 02:05'!mostrarCasillas    ^casillas collect: [:c | c coordenadas].! !!Jugador methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:57'!descontarTiempo: segundos    "Descuenta tiempo del jugador. Si el tiempo llega a cero, lanza un aviso."    tiempoDisponible := tiempoDisponible - segundos.    tiempoDisponible < 0 ifTrue: [tiempoDisponible := 0].! !!Jugador methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:56'!tiempoDisponible: unTiempo    "Asigna un nuevo tiempo disponible al jugador."    tiempoDisponible := unTiempo.! !!Jugador methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:51'!nombre: unNombre	 "setter"    nombre := unNombre.! !!Jugador methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:55'!casillas    "Devuelve la colección de casillas del jugador."    ^casillas.! !!Jugador methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:56'!tiempoDisponible    "Devuelve el tiempo disponible del jugador."    ^tiempoDisponible.! !!Jugador methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:52'!nombre    "Devuelve el nombre del jugador."    ^nombre.! !!Jugador methodsFor: 'initialization' stamp: 'Alan 11/21/2024 02:04'!initializeWith: unNombre tiempo: unTiempo    nombre := unNombre.    tiempoDisponible := unTiempo.    casillas := OrderedCollection new.! !Object subclass: #MiniJuego	instanceVariableNames: 'nombre descripcion'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquistaDefinitiva'!!MiniJuego methodsFor: 'as yet unclassified' stamp: 'Alan 11/21/2024 11:01'!asString     ^'Mini juego: ', nombre, ' - ', descripcion.! !!MiniJuego methodsFor: 'initialization' stamp: 'Alan 11/21/2024 10:58'!initialize    nombre := ''.    descripcion := ''.! !!MiniJuego methodsFor: 'accessing' stamp: 'Alan 11/21/2024 02:23'!descripcion    ^descripcion.! !!MiniJuego methodsFor: 'accessing' stamp: 'Alan 11/21/2024 10:58'!nombre: unNombre	nombre:= unNombre.! !!MiniJuego methodsFor: 'accessing' stamp: 'Alan 11/21/2024 02:23'!nombre    ^nombre.! !!MiniJuego methodsFor: 'accessing' stamp: 'Alan 11/21/2024 10:59'!descripcion: unaDescripcion    descripcion:= unaDescripcion.! !Object subclass: #Tablero	instanceVariableNames: 'grilla minijuegos'	classVariableNames: ''	poolDictionaries: ''	category: 'LaConquistaDefinitiva'!!Tablero methodsFor: 'initialization' stamp: 'Alan 11/21/2024 11:35'!initialize    "Inicializa la grilla y carga los minijuegos"    grilla := Array new: 8.    1 to: 8 do: [:i | grilla at: i put: (Array new: 8)].    self cargarMinijuegos.! !!Tablero methodsFor: 'accessing' stamp: 'Alan 11/21/2024 11:20'!imprimirGrilla	grilla		do: [ :fila | 			fila do: [ :casillero | 				Transcript show: casillero asString; tab.			].			Transcript cr.		].! !!Tablero methodsFor: 'accessing' stamp: 'Alan 11/21/2024 01:39'!grilla	^grilla.! !!Tablero methodsFor: 'as yet unclassified' stamp: 'Alan 11/21/2024 11:34'!cargarMinijuegos    "Genera una lista de minijuegos y los asigna a la grilla"    minijuegos := OrderedCollection new.        minijuegos add: (MiniJuego new nombre: 'Adivina el número'; descripcion: 'Encuentra el número entre 1 y 10').        minijuegos add: (MiniJuego new nombre: 'Memoria'; descripcion: 'Recuerda y empareja las cartas').        minijuegos add: (MiniJuego new nombre: 'Trivia'; descripcion: 'Responde preguntas de conocimiento general').        minijuegos add: (MiniJuego new nombre: 'Rompecabezas'; descripcion: 'Arma el rompecabezas antes del tiempo límite').    1 to: 8 do: [:i |        1 to: 8 do: [:j |            | casillero minijuego |            casillero := Casillero new.            minijuego := minijuegos at: (1 to: minijuegos size) atRandom.            casillero minijuego: minijuego.            (grilla at: i) at: j put: casillero.        ]].! !